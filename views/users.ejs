<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Show Users</title>
  <style> 
    table, tr, th, td {
    border: 1px solid black;            
  }</style>
</head>
<body>
  <table>
    <tr>
      <th>ID</th>
      <th>USERNAME</th>
      <th>EMAIL</th>
    </tr>

    <% for (user of users) { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td>
          <form method="GET" action="/user/<%=user.id%>/edit">
            <button>Edit username</button>
          </form>
        </td>
        <td>
          <a href="/user/<%= user.id %>/delete">Delete User</a>
        </td>
      </tr>
    <% } %>
  </table>
</body>
</html>